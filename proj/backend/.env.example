# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobtracker
DB_USERNAME=jobtracker_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- JWT ---
# Generate a long random secret, e.g.: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS_LONG
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- File uploads ---
UPLOAD_DIR=./uploads

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- AI (optional) ---
# Get a key at https://console.anthropic.com . Empty = rule-based fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
